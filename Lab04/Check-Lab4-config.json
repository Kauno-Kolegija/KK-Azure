  "SubnetNSG": {
    "Names": {
      "LT": "NSG-Sandelis-Subnet",
      "EN": "NSG-Warehouse-Subnet"
    },
    "SqlRule": {
      "Name": "Allow-SQL",
      "Port": "1433",
      "Access": "Allow",
      "Priority": 500
    },
    "PingRule": {
      "Name": "Allow-Ping",
      "Access": "Allow",
      "Priority": 510
    }
  },

  "VmNSG": {
    "Rule": {
      "Name": {
        "LT": "Deny-SQL-LocalServer",
