    },
    "TagsMissing": {
      "LT": "Trūksta privalomų žymių",
      "EN": "Required tags are missing"
    }
  },

  "ResourceGroup": {
    "Pattern": "^RG-LAB05-.+$"
  },

  "Network": {
    "VNetPattern": "^.+-VNet$",
    "AddressSpace": "10.15.0.0/16",
    "Subnet": {
      "Name": "WebSubnet",
      "Prefix": "10.15.0.0/24"
    }
  },

  "NSG": {
    "NamePattern": "^.+-NSG$",

    "WebRule": {
      "Name": "Allow_WEB",
      "Protocol": "Tcp",
      "DestinationPort": "80",
      "Access": "Allow"
    },

    "RdpRule": {
      "Name": "Allow_RDP",
      "Protocol": "Tcp",
      "DestinationPort": "3389",
      "Access": "Allow"
    },

    "Priority": {
      "Minimum": 100,
      "Maximum": 4096,
      "MustBeUnique": true
    }
  },

  "AvailabilitySet": {
    "NamePattern": "^.+-AvailabilitySet$",
    "FaultDomains": 2,
    "UpdateDomains": 2
  },

  "VirtualMachines": {
    "VM1Pattern": "^.+-VM-001$",
    "VM2Pattern": "^.+-VM-002$"
  },

  "LoadBalancer": {
    "NamePattern": "^.+-NLB$",
    "Sku": "Standard",

    "PublicIPPattern": "^.+-NLB-PublicIP$",

    "Frontend": {
      "Name": "NLBFrontEnd"
    },

    "BackendPool": {
      "Name": "WEBServerPool",
      "RequiredMembers": 2
    },

    "Probe": {
      "Name": "WebHealthProbe",
      "Protocol": "Tcp",
      "Port": 80
    },

    "Rule": {
      "Name": "myHTTPRule",
      "Protocol": "Tcp",
      "FrontendPort": 80,
      "BackendPort": 80,
      "FrontendName": "NLBFrontEnd",
      "BackendPoolName": "WEBServerPool",
      "ProbeName": "WebHealthProbe"
    }
  },

  "Tags": {
    "VirtualMachines": {
      "Environment": "Production",
      "CreatedByRequired": true,
      "NLBRequired": true
    },

    "VNet": {
      "Lab": "Networking",
      "Environment": "Production"
    }
  }
}